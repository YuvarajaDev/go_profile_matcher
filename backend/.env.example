DB_HOST=localhost
DB_PORT=5433
DB_NAME=profile_matcher
DB_USER=postgres
DB_PASSWORD=postgres

# AWS Bedrock credentials
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION_NAME=us-east-1

# LLM model — change this one line to switch models, no code change needed
# Examples:
#   bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0  (AWS Bedrock Haiku)
#   bedrock/anthropic.claude-3-5-sonnet-20241022-v2:0        (AWS Bedrock Sonnet)
#   gpt-4o                                                    (OpenAI)
#   groq/llama-3.3-70b-versatile                             (Groq)
LLM_MODEL=bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0

